# backend/.env 얼개 — 이 파일을 `.env` 로 복사해 값을 채운다.
# `.env` 는 절대 커밋하지 않는다(CLAUDE.md §5). 이 예시 파일만 커밋 대상이다.
#
# 비어 있어도 로컬은 돈다 — 코드가 기본값을 갖고 있다.
# 여기 있는 것은 "채우면 그 기능이 켜지는" 스위치 목록이다.

# ── Django ───────────────────────────────────────────────────────────
# 운영에서는 반드시 채운다. 로컬 기본값은 dev-insecure-change-me 다.
DJANGO_SECRET_KEY=

# ── 로컬 인프라 (docker compose 기본값과 같다 — 보통 비워 둔다) ────────
# DATABASE_URL=postgres://lms:lms@localhost:5432/lms
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# ── Mux 서명 재생 (apps/videos/mux.py) ───────────────────────────────
# Playback ID 정책이 `signed` 면 서버가 JWT 를 서명해야 재생된다.
# 대시보드 Settings → Signing Keys 에서 발급하면 둘이 나온다.
#   MUX_SIGNING_KEY_ID       짧은 문자열(공개돼도 무해)
#   MUX_SIGNING_PRIVATE_KEY  base64 개인키 — **시크릿**. 절대 커밋·공유 금지
# 비워 두면 서명하지 않는다(= `public` 정책 영상과 데모만 재생된다).
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# ── Mux REST API (업로드 커맨드 전용) ────────────────────────────────
# **서명 키와 다른 값이다.** 대시보드 Settings → Access Tokens 에서 발급.
#   MUX_TOKEN_ID      Access Token ID
#   MUX_TOKEN_SECRET  Secret Key — **시크릿**
# 재생에는 필요 없다. `manage.py mux_upload` 만 쓴다.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# 시드 영상(`seed-*` 가짜 참조)이 대신 재생할 실제 자산의 Playback ID.
# 개발 편의용 — 비면 대체하지 않는다(운영에는 시드 데이터가 없다).
MUX_DEMO_PLAYBACK_ID=

# ── 에러 추적 (config/settings/prod.py) ──────────────────────────────
# sentry.io 가입 후 DSN. 비면 Sentry 는 조용히 꺼진 채로 돈다.
SENTRY_DSN=

# ── 워크북 사진 저장소 (S3) ──────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
