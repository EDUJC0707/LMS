# backend/.env 얼개 — 이 파일을 `.env` 로 복사해 값을 채운다.
# `.env` 는 절대 커밋하지 않는다(CLAUDE.md §5). 이 예시 파일만 커밋 대상이다.
#
# 비어 있어도 로컬은 돈다 — 코드가 기본값을 갖고 있다.
# 여기 있는 것은 "채우면 그 기능이 켜지는" 스위치 목록이다.

# ── Django ───────────────────────────────────────────────────────────
# 운영에서는 반드시 채운다. 로컬 기본값은 dev-insecure-change-me 다.
DJANGO_SECRET_KEY=

# ── 로컬 인프라 (docker compose 기본값과 같다 — 보통 비워 둔다) ────────
# DATABASE_URL=postgres://lms:lms@localhost:5432/lms
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# ── Mux 서명 재생 (apps/videos/mux.py) ───────────────────────────────
# Playback ID 정책이 `signed` 면 서버가 JWT 를 서명해야 재생된다.
# 대시보드 Settings → Signing Keys 에서 발급하면 둘이 나온다.
#   MUX_SIGNING_KEY_ID       짧은 문자열(공개돼도 무해)
#   MUX_SIGNING_PRIVATE_KEY  base64 개인키 — **시크릿**. 절대 커밋·공유 금지
# 비워 두면 서명하지 않는다(= `public` 정책 영상과 데모만 재생된다).
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# 재생 제한 규칙 id — 서명 토큰에 실어 Referer·User-Agent 를 함께 검사한다.
# `manage.py mux_restriction --domain <도메인>` 으로 만들고 그 id 를 넣는다.
# 비면 제한 없이 서명한다(= URL 만 있으면 curl 로도 받아진다).
MUX_PLAYBACK_RESTRICTION_ID=

# ── Mux REST API (업로드 커맨드 전용) ────────────────────────────────
# **서명 키와 다른 값이다.** 대시보드 Settings → Access Tokens 에서 발급.
#   MUX_TOKEN_ID      Access Token ID
#   MUX_TOKEN_SECRET  Secret Key — **시크릿**
# 재생에는 필요 없다. `manage.py mux_upload` 만 쓴다.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# 시드 영상(`seed-*` 가짜 참조)이 대신 재생할 실제 자산의 Playback ID.
# 개발 편의용 — 비면 대체하지 않는다(운영에는 시드 데이터가 없다).
MUX_DEMO_PLAYBACK_ID=

# ── 에러 추적 (config/settings/prod.py) ──────────────────────────────
# sentry.io 가입 후 DSN. 비면 Sentry 는 조용히 꺼진 채로 돈다.
SENTRY_DSN=

# ── 워크북 사진 저장소 (S3) ──────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# ── 클리닉 화상 — Google Meet (config/settings/base.py · apps/clinic/google_meet.py) ──
# 비면 배정 시 서버가 방을 못 만든다(관리자 수동 링크 입력으로만 성립).
# 재발급: manage.py meet_authorize (Workspace·데스크톱 앱 설정은 그 커맨드 머리말).
# REFRESH_TOKEN 원본은 여기 하나뿐 — 잃으면 재발급해야 한다(다른 값이 나온다).
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
# 업체 교체 지점. 빈 문자열이면 배정이 닫힘(PermanentConferenceError).
# CLINIC_CONFERENCE_BACKEND=apps.clinic.google_meet.GoogleMeetAdapter

# ── 알림 발송 — 알리고 (apps/notifications/aligo.py) ─────────────────
# 비면 발송이 "API 키가 설정되지 않았습니다" 로 실패한다(조용한 성공 없음).
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_PHONE=
ALIGO_SENDER_KEY=

# ── 결제 — 결제선생(페이민트) (apps/payments/) ───────────────────────
# **구현체 선택은 여기 두지 않는다** — 설정 모듈이 정한다(dev=Fake, prod=결제선생).
# 여기 두면 이 파일 하나가 dev 의 Fake 를 덮어써 로컬에서 진짜 청구서가 나간다.
# 잔액 조회처럼 보내지 않는 호출을 실업체로 확인할 때만 한 번씩 인라인으로 준다:
#   PAYMENT_PROVIDER_BACKEND=apps.payments.payssam.PayssamAdapter manage.py runserver
# 샌드박스 키는 계약 후 업체가 발급한다. **운영 키는 연동 검수 통과 후 별도 발급.**
# 개발자센터: https://developers.payssam.kr (V2 기준 — V1/stg 는 폐기)
PAYSSAM_API_KEY=
PAYSSAM_MEMBER_ID=
PAYSSAM_MERCHANT_ID=
# 미설정 시 샌드박스로 떨어진다. 운영 배포에서는 검수 후 받은 주소를 반드시 넣는다.
# PAYSSAM_API_BASE_URL=
# 결제 승인 콜백이 돌아올 우리 쪽 공개 주소(예: https://lms.hjcedu.com).
# 로컬에서는 터널 주소를 넣어야 승인 통지를 받을 수 있다.
PAYSSAM_CALLBACK_BASE_URL=

# ── Sentry 릴리스 태그 (config/settings/prod.py) ─────────────────────
# 이미지 빌드가 GIT_SHA 로 넣어 준다(infra/Dockerfile). 로컬에선 비워 둔다.
# SENTRY_RELEASE=

# ── 쿠키 도메인 (config/settings/prod.py · 운영 전용) ────────────────
# 프런트와 API 가 다른 서브도메인이면 반드시 채운다. 비면 쿠키가 API 도메인
# 전용으로 발급돼 프런트에서 로그인이 유지되지 않는다. 로컬은 비워 둔다.
# SESSION_COOKIE_DOMAIN=.hjcedu.com
# CSRF_COOKIE_DOMAIN=.hjcedu.com
