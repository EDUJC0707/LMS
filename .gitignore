.DS_Store

# 의존성
node_modules/
.venv/
# 슬래시 있는 규칙은 디렉터리만 잡는다 — 워크트리에서 .venv 를 심볼릭 링크로
# 걸면 파일로 보여 미추적으로 뜬다(2026-08-04). 두 형태를 다 막는다.
.venv
__pycache__/
*.pyc

# 빌드 산출물
frontend/dist/
*.tsbuildinfo

# 로컬 업로드·시드 산출물(워크북 사진 등) — 운영은 Tigris/S3
backend/media/

# 에이전트 worktree (임시 작업 사본 — 절대 커밋 금지)
.claude/worktrees/

# 환경변수·시크릿
.env
.env.local

# 아카이브 — 과거 산출물·리서치·회의록·디자인 원본·RPA 프로토타입
# (로그인 쿠키가 든 chrome-profile, 대용량 이미지 포함. 로컬 보관, git 제외)
local/

# .claude/ 는 커밋 대상이다 (CLAUDE.md = 프로젝트 규칙). 무시하지 말 것.
# 단, 기기별 로컬 설정만 제외.
.claude/settings.local.json

# Playwright MCP 캡처 산출물 (로컬 전용)
.playwright-mcp/
# 스크린샷에 디렉터리 없이 파일명만 주면 저장소 루트로 떨어진다.
# 앞의 `/` 가 루트만 뜻하므로 assets/logo/*.png · docs/db/lms-erd.png 등
# 추적 중인 12장은 그대로 남는다.
/*.png

# 랜딩 리허설 실험 산출물 (영상·프레임 — 로컬 전용)
frontend/landing/rehearsal/
frontend/landing/frames/

# 랜딩 참고 스크린샷 (로컬 전용)
frontend/landing/temp/
