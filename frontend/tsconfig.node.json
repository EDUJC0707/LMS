{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // composite 프로젝트라 emit 을 끌 수 없다. 기본값이면 vite.config.js 가
    // 프로젝트 루트에 떨어지는데, vite 는 .ts 보다 .js 를 먼저 집으므로
    // 낡은 산출물이 조용히 설정을 덮어쓴다. 산출물을 프로젝트 밖으로 뺀다.
    "outDir": "./node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts"]
}
